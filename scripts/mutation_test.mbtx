---
import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/process" @proc,
}
---

// re-mbt 变异测试（MoonBit 脚本；运行：moon run scripts/mutation_test.mbtx）
// 经验来自 agentskills.mbt / gbz185.mbt：自动化统一用 .mbtx，不引入 Python/Node 脚本。
// 对每个变异：生成变异源文件 → moon test → 判定 KILLED/SURVIVED → 恢复 → 汇总。
// 回归红线：killed == total（击杀率 100%）。

///|
struct Mutation {
  id : String
  file : String
  old_sub : String
  new_sub : String
  desc : String
}

///|
let mutations : Array[Mutation] = [
  {
    id: "M01",
    file: "re_ast/ast_witness.mbt",
    old_sub: "Alternative(l) => if l.is_empty() { None } else { Ast::witness(l[0]) }",
    new_sub: "Alternative(l) => if l.is_empty() { Some(b\"\") } else { Ast::witness(l[0]) }",
    desc: "empty alternative becomes matchable",
  },
  {
    id: "M02",
    file: "re_ast/ast_witness.mbt",
    old_sub: "CsetOf(c) => Some(c)",
    new_sub: "CsetOf(c) => None",
    desc: "cset witness becomes impossible",
  },
  {
    id: "M03",
    file: "re_ast/ast_witness.mbt",
    old_sub: "Bytes::from_array([b.to_byte()])",
    new_sub: "Bytes::from_array([0])",
    desc: "witness byte replaced by NUL",
  },
  {
    id: "M04",
    file: "re_ast/ast_witness.mbt",
    old_sub: "NoCase(x) => witness_cset(x)",
    new_sub: "NoCase(x) => None",
    desc: "no-case cast lost in witness",
  },
  {
    id: "M05",
    file: "re_ast/ast_witness.mbt",
    old_sub: "Some(@base.Cset::diff(@base.Cset::cany(), @base.Cset::union_all(parts)))",
    new_sub: "Some(@base.Cset::empty())",
    desc: "complement witness collapses to empty",
  },
  {
    id: "M06",
    file: "re_ast/ast_witness.mbt",
    old_sub: "Some(m) => if m < 1 { 0 } else if min < 1 { 1 } else { min }",
    new_sub: "Some(m) => if m < 1 { 1 } else if min < 1 { 1 } else { min }",
    desc: "repeat max=0 no longer empty",
  },
  {
    id: "M07",
    file: "re_frontend/posix_class.mbt",
    old_sub: "if !@base.ParseBuffer::accept(buf, ':') {",
    new_sub: "if false {",
    desc: "posix class prefix check removed",
  },
  {
    id: "M08",
    file: "re_frontend/posix_class.mbt",
    old_sub: "if cls is None {",
    new_sub: "if cls is Some(_) {",
    desc: "posix class name scan inverted",
  },
  {
    id: "M09",
    file: "re_frontend/posix_class.mbt",
    old_sub: "if !@base.ParseBuffer::accept_s(buf, posix_class_close) {",
    new_sub: "if false {",
    desc: "posix class closing bracket check removed",
  },
  {
    id: "M10",
    file: "re_ast/ast_witness.mbt",
    old_sub: "Intersection(l) => {",
    new_sub: "Intersection(l) => return None",
    desc: "intersection witness becomes impossible",
  },
]

///|
fn replace_all(s : String, old : String, new : String) -> String {
  let parts = s.split(old).collect()
  if parts.length() == 1 {
    return s
  }
  let buf = StringBuilder()
  for i, p in parts {
    buf.write_string(p.to_owned())
    if i < parts.length() - 1 {
      buf.write_string(new)
    }
  }
  buf.to_string()
}

///|
async fn run_tests() -> Int {
  let (code, _out, _err) = @proc.collect_output(
    "moon",
    ["test", "--target", "native"],
    cwd=".",
  ) catch {
    _ => panic()
  }
  code
}

///|
async fn main raise {
  let mut killed = 0
  let mut survived = 0
  let mut skipped = 0
  let results : Array[String] = []
  for m in mutations {
    let original = @fs.read_file(m.file).text() catch { _ => panic() }
    if original.split(m.old_sub).collect().length() != 2 {
      skipped += 1
      results.push("\{m.id}: SKIPPED (pattern not unique) — \{m.desc}")
      continue
    }
    let mutated = replace_all(original, m.old_sub, m.new_sub)
    @fs.write_file(m.file, mutated)
    let code = run_tests()
    @fs.write_file(m.file, original)
    if code == 0 {
      survived += 1
      results.push("\{m.id}: SURVIVED — \{m.desc}")
    } else {
      killed += 1
      results.push("\{m.id}: KILLED — \{m.desc}")
    }
  }
  let final_code = run_tests()
  for r in results {
    println(r)
  }
  println("=== mutation summary ===")
  println(
    "killed=\{killed} survived=\{survived} skipped=\{skipped} total=\{mutations.length()}",
  )
  if final_code != 0 {
    println("WARNING: baseline tests failing after restore — manual check needed")
    panic()
  }
  if survived > 0 || skipped > 0 {
    println("FAIL: survived/skipped above zero")
    panic()
  }
  println("PASS: all mutations killed")
}