// witness 性质测试：witness 生成的串必须能被该 AST 编译后的正则匹配（自洽性）
// property tests: the string generated by witness must match the compiled regex

///|
test "witness char matches itself" {
  let ast = @ast.Ast::char('a')
  let re = @re_compile.compile(ast)
  match @re_compile.Re::witness(ast) {
    Some(w) => assert_eq(@re_compile.execp(re, w), true)
    None => assert_eq(true, false)
  }
}

///|
test "witness sequence" {
  let ast = @ast.Ast::seq([
    @ast.Ast::char('h'),
    @ast.Ast::opt(@ast.Ast::char('i')),
    @ast.Ast::char('!'),
  ])
  match @ast.Ast::witness(ast) {
    Some(w) => {
      assert_eq(w, b"hi!")
      assert_eq(@re_compile.execp(@re_compile.compile(ast), w), true)
    }
    None => assert_eq(true, false)
  }
}

///|
test "witness repeat min" {
  let ast = @ast.Ast::repn(@ast.Ast::char('a'), 3, None)
  match @ast.Ast::witness(ast) {
    Some(w) => {
      assert_eq(w, b"aaa")
      assert_eq(@re_compile.execp(@re_compile.compile(ast), w), true)
    }
    None => assert_eq(true, false)
  }
}

///|
test "witness alt takes first branch" {
  let ast = @ast.Ast::alt([@ast.Ast::char('a'), @ast.Ast::char('b')])
  match @ast.Ast::witness(ast) {
    Some(w) => {
      assert_eq(w, b"a")
      assert_eq(@re_compile.execp(@re_compile.compile(ast), w), true)
    }
    None => assert_eq(true, false)
  }
}

///|
test "witness complement is not the excluded char" {
  let ast = @ast.Ast::compl([@ast.Ast::char('a')])
  match @ast.Ast::witness(ast) {
    Some(w) => assert_eq(@re_compile.execp(@re_compile.compile(ast), w), true)
    None => assert_eq(true, false)
  }
}

///|
test "witness group and anchors" {
  let ast = @ast.Ast::group(
    name=Some("g"),
    @ast.Ast::seq([@ast.Ast::bol(), @ast.Ast::char('x'), @ast.Ast::eol()]),
  )
  match @ast.Ast::witness(ast) {
    Some(w) => {
      assert_eq(w, b"x")
      assert_eq(@re_compile.execp(@re_compile.compile(ast), w), true)
    }
    None => assert_eq(true, false)
  }
}

///|
test "witness empty cset is None" {
  let ast = @ast.Ast::cset(@base.Cset::empty())
  match @ast.Ast::witness(ast) {
    Some(_) => assert_eq(true, false)
    None => assert_eq(true, true)
  }
}

///|
test "witness range cset" {
  let ast = @re_compile.Re::rg('a', 'z')
  match @re_compile.Re::witness(ast) {
    Some(w) => {
      assert_eq(w, b"a")
      assert_eq(@re_compile.execp(@re_compile.compile(ast), w), true)
    }
    None => assert_eq(true, false)
  }
}
