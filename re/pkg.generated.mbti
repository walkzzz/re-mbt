pub enum ViewT {
  SetT(Cset)
  SequenceT(Array[AstGen[AstCset]])
  AlternativeT(Array[AstGen[AstCset]])
  RepeatT(AstGen[AstCset], Int, Int?)
  BegOfLineT
  EndOfLineT
  BegOfWordT
  EndOfWordT
  NotBoundT
  BegOfStrT
  EndOfStrT
  LastEndOfLineT
  StartT
  StopT
  SemT(Sem, AstGen[AstCset])
  SemGreedyT(RepKind, AstGen[AstCset])
  GroupT(String?, AstGen[AstCset])
  NoGroupT(AstGen[AstCset])
  NestT(AstGen[AstCset])
  CaseT(AstGen[AstCset])
  NoCaseT(AstGen[AstCset])
  IntersectionT(Array[AstGen[AstCset]])
  ComplementT(Array[AstGen[AstCset]])
  DifferenceT(AstGen[AstCset], AstGen[AstCset])
  PmarkT(Pmark, AstGen[AstCset])
}

